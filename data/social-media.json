{
    "github": {
        "validator": "^(((https?://)?(www\\.)?)?github.com/)?(?<username>[a-zA-Z0-9-]+)$",
        "placeholder": "GitHub username",
        "profileUrl": "https://github.com/"
    },
    "linkedin": {
        "validator": "^(((https?://)?(www\\.)?)?linkedin.com/in/)?(?<username>[a-zA-Z0-9-]+)$",
        "placeholder": "LinkedIn profile URL",
        "profileUrl": "https://linkedin.com/in/"
    },
    "researchgate": {
        "validator": "^(((https?://)?(www\\.)?)?researchgate.net/profile/)?(?<username>[a-zA-Z0-9-]+)$",
        "placeholder": "https://researchgate.net/profile/username",
        "profileUrl": "https://researchgate.net/profile/"
    },
    "youtube": {
        "validator": "^(((https?://)?(www\\.)?)?(youtube.com/|youtu.be/))?@?(?<username>[a-zA-Z0-9_.-]+)$",
        "placeholder": "@username",
        "profileUrl": "https://youtube.com/@"
    },
    "mastodon": {
        "domain": [],
        "validator": "^(https?://)?(?<username>[a-zA-Z0-9._-]+\\.[a-zA-Z]{2,}/@?[a-zA-Z0-9_-]+)$",
        "placeholder": "server.domain/@username",
        "profileUrl": "https://"
    },  
    "bluesky": {
        "validator": "^(((https?://)?(www\\.)?)?bsky\\.app/profile/)?@?(?<username>[a-zA-Z0-9.-]+)$",
        "placeholder": "username.bsky.social || username.domain",
        "profileUrl": "https://bsky.app/profile/"
    },
    "instagram": {
        "validator": "^(((https?://)?(www\\.)?)?instagram\\.com/)?@?(?<username>[a-zA-Z0-9_.]+)$",
        "placeholder": "@username",
        "profileUrl": "https://instagram.com/"
    },
    "facebook": {
        "validator": "^(((https?://)?(www\\.)?)?facebook\\.com/)?@?(?<username>[a-zA-Z0-9.]+)$",
        "placeholder": "username",
        "profileUrl": "https://facebook.com/"
    },
    "x": {
        "validator": "^(((https?://)?(www\\.)?)?(x\\.com|twitter\\.com)/)?(?<username>[a-zA-Z0-9_]+)$",
        "placeholder": "Username or link to profile",
        "profileUrl": "https://x.com/"
    },
    "matrix": {
        "validator": "^((https?://)?matrix.to/#/)?@?(?<username>[a-zA-Z0-9._+/=-]+:[a-zA-Z0-9._-]+\\.[a-zA-Z]{2,})$",
        "placeholder": "@username:server.domain",
        "profileUrl": "https://matrix.to/#/@"
    },
    "website": {
        "validator": "^((https?://)?(www\\.)?)?(?<username>.{5,})$",
        "placeholder": "URL to website",
        "profileUrl": "https://"
    },
    "telegram": {
        "validator": "^(((https?://)?(www\\.)?)?(t\\.me)/)?(?<username>[a-zA-Z0-9_]+)$",
        "placeholder": "Username or URL to profile",
        "profileUrl": "https://t.me/"
    },
    "reddit": {
        "validator": "^(((https?://)?(www\\.)?)?(reddit\\.com)/user/)?(?<username>[a-zA-Z0-9_-]+)$",
        "placeholder": "Username or URL to profile",
        "profileUrl": "https://reddit.com/user/"
    },
    "tiktok": {
        "validator": "^(((https?://)?(www\\.)?)?(tiktok\\.com)/@)?(?<username>[a-zA-Z0-9._]+)$",
        "placeholder": "Username or URL to profile",
        "profileUrl": "https://tiktok.com/@"
    },
    "slack": {
        "validator": "^((https?://)?(www\\.)?)?(?<username>[a-zA-Z0-9._-]+\\.slack\\.com/team/@?[a-zA-Z0-9._-]+)$",
        "placeholder": "organization.slack.com/team/@username",
        "profileUrl": "https://"
    },
    "teams": {
        "validator": "^(((https?://)?(www\\.)?)?(teams\\.(cloud\\.)?microsoft(\\.com)?)/l/chat/0/0\\?users=)?@?(?<username>[a-zA-Z0-9._@-]+)$",
        "placeholder": "User mail",
        "profileUrl": "https://teams.microsoft.com/l/chat/0/0?users="
    }
}